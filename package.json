{
  "name": "pybricks-runner",
  "displayName": "Pybricks Runner",
  "description": "Program LEGO SPIKE Prime and EV3 robots using Pybricks",
  "version": "0.4.2",
  "publisher": "AnandSingh",
  "icon": "pybricks-runner-icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnandSingh/pybricks-runner-vscode.git"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pybricksRunner",
          "title": "Pybricks Runner",
          "icon": "media/pybricks-activitybar.svg"
        }
      ]
    },
    "views": {
      "pybricksRunner": [
        {
          "id": "pybricks.devices",
          "name": "Devices",
          "type": "tree"
        },
        {
          "id": "pybricks.selectedRobot",
          "name": "Selected Robot",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "pybricks.run",
        "title": "Run on LEGO Brick",
        "category": "Pybricks",
        "icon": "$(rocket)"
      },
      {
        "command": "pybricks.stopProgram",
        "title": "Stop Running Program",
        "category": "Pybricks",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pybricks.connectHub",
        "title": "Connect to Hub",
        "category": "Pybricks",
        "icon": "$(plug)"
      },
      {
        "command": "pybricks.disconnectHub",
        "title": "Disconnect from Hub",
        "category": "Pybricks",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "pybricks.toggleConnection",
        "title": "Connect / Disconnect Hub",
        "category": "Pybricks"
      },
      {
        "command": "pybricks.selectRobot",
        "title": "Select LEGO Robot",
        "category": "Pybricks",
        "icon": "$(settings-gear)"
      },
      {
        "command": "pybricks.scanDevices",
        "title": "Scan for Devices",
        "category": "Pybricks",
        "icon": "$(search)"
      },
      {
        "command": "pybricks.refreshDevices",
        "title": "Refresh Device List",
        "category": "Pybricks",
        "icon": "$(refresh)"
      },
      {
        "command": "pybricks.addRobot",
        "title": "Add Robot by Name",
        "category": "Pybricks",
        "icon": "$(add)"
      },
      {
        "command": "pybricks.selectDevice",
        "title": "Set as Target",
        "category": "Pybricks",
        "icon": "$(circle-filled)"
      },
      {
        "command": "pybricks.deselectDevice",
        "title": "Clear Target",
        "category": "Pybricks",
        "icon": "$(circle-large-outline)"
      },
      {
        "command": "pybricks.forgetDevice",
        "title": "Remove from Saved List",
        "category": "Pybricks",
        "icon": "$(trash)"
      },
      {
        "command": "pybricks.manageSavedDevices",
        "title": "Remove Saved Robots...",
        "category": "Pybricks",
        "icon": "$(list-selection)"
      },
      {
        "command": "pybricks.clearSavedDevices",
        "title": "Remove All Saved Robots",
        "category": "Pybricks",
        "icon": "$(clear-all)"
      },
      {
        "command": "pybricks.showLog",
        "title": "Show Log",
        "category": "Pybricks",
        "icon": "$(output)"
      },
      {
        "command": "pybricks.showDebugInfo",
        "title": "Show Debug Info",
        "category": "Pybricks",
        "icon": "$(bug)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "pybricks.run",
          "group": "navigation@1",
          "when": "resourceExtname == .py"
        },
        {
          "command": "pybricks.stopProgram",
          "group": "navigation@2",
          "when": "resourceExtname == .py && pybricks.connected"
        },
        {
          "command": "pybricks.selectRobot",
          "group": "navigation@3",
          "when": "resourceExtname == .py"
        }
      ],
      "view/title": [
        {
          "command": "pybricks.scanDevices",
          "when": "view == pybricks.devices",
          "group": "navigation@1"
        },
        {
          "command": "pybricks.connectHub",
          "when": "view == pybricks.devices && !pybricks.connected",
          "group": "navigation@2"
        },
        {
          "command": "pybricks.disconnectHub",
          "when": "view == pybricks.devices && pybricks.connected",
          "group": "navigation@2"
        },
        {
          "command": "pybricks.addRobot",
          "when": "view == pybricks.devices",
          "group": "navigation@3"
        },
        {
          "command": "pybricks.stopProgram",
          "when": "view == pybricks.devices && pybricks.connected",
          "group": "1_hub@1"
        },
        {
          "command": "pybricks.refreshDevices",
          "when": "view == pybricks.devices",
          "group": "2_list@1"
        },
        {
          "command": "pybricks.manageSavedDevices",
          "when": "view == pybricks.devices",
          "group": "3_manage@1"
        },
        {
          "command": "pybricks.clearSavedDevices",
          "when": "view == pybricks.devices",
          "group": "3_manage@2"
        },
        {
          "command": "pybricks.showLog",
          "when": "view == pybricks.devices",
          "group": "4_debug@1"
        }
      ],
      "view/item/context": [
        {
          "command": "pybricks.connectHub",
          "when": "view == pybricks.devices && viewItem =~ /\\.offline\\b/",
          "group": "inline@1"
        },
        {
          "command": "pybricks.disconnectHub",
          "when": "view == pybricks.devices && viewItem =~ /\\.connected\\b/",
          "group": "inline@1"
        },
        {
          "command": "pybricks.forgetDevice",
          "when": "view == pybricks.devices && viewItem =~ /\\.saved\\b/",
          "group": "inline@2"
        },
        {
          "command": "pybricks.connectHub",
          "when": "view == pybricks.devices && viewItem =~ /\\.offline\\b/",
          "group": "1_hub@1"
        },
        {
          "command": "pybricks.disconnectHub",
          "when": "view == pybricks.devices && viewItem =~ /\\.connected\\b/",
          "group": "1_hub@1"
        },
        {
          "command": "pybricks.selectDevice",
          "when": "view == pybricks.devices && viewItem =~ /\\.unselected\\b/",
          "group": "2_select@1"
        },
        {
          "command": "pybricks.deselectDevice",
          "when": "view == pybricks.devices && viewItem =~ /\\.selected\\b/",
          "group": "2_select@1"
        },
        {
          "command": "pybricks.forgetDevice",
          "when": "view == pybricks.devices && viewItem =~ /\\.saved\\b/",
          "group": "3_remove@1"
        }
      ],
      "commandPalette": [
        {
          "command": "pybricks.forgetDevice",
          "when": "false"
        },
        {
          "command": "pybricks.selectDevice",
          "when": "false"
        },
        {
          "command": "pybricks.toggleConnection",
          "when": "false"
        },
        {
          "command": "pybricks.stopProgram",
          "when": "pybricks.connected"
        },
        {
          "command": "pybricks.disconnectHub",
          "when": "pybricks.connected"
        },
        {
          "command": "pybricks.connectHub",
          "when": "!pybricks.connected"
        }
      ]
    },
    "configuration": {
      "title": "Pybricks Runner",
      "properties": {
        "pybricksRunner.robotName": {
          "type": "string",
          "default": "",
          "description": "Default robot (BLE name) to auto-select."
        },
        "pybricksRunner.scanTimeout": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "How long, in seconds, to scan for nearby hubs."
        },
        "pybricksRunner.showAllBluetoothDevices": {
          "type": "boolean",
          "default": false,
          "description": "Report every named Bluetooth LE device, not just LEGO hubs. Useful for troubleshooting a hub that does not show up."
        },
        "pybricksRunner.scanOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "Scan for nearby hubs automatically when the extension activates."
        },
        "pybricksRunner.connectTimeout": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 120,
          "description": "How long, in seconds, to look for the hub when connecting."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "pybricks.devices",
        "contents": "No robots yet.\n\nPower on your hub and hold its Bluetooth button until it blinks, then scan.\n[Scan for Devices](command:pybricks.scanDevices)\n\nAlready know the name? Add it directly.\n[Add Robot by Name](command:pybricks.addRobot)"
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.100.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.2"
  }
}
